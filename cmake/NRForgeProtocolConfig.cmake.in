@PACKAGE_INIT@
set(@package@_VERSION "@NRFORGE_SDK_VERSION@")
set(@package@_FINGERPRINT "@NRFORGE_SDK_FINGERPRINT@")
set(@package@_SCHEMA_SHA256 "@NRFORGE_SCHEMA_SHA256@")
set(@package@_RUNTIME_SHA256 "@NRFORGE_RUNTIME_SHA256@")
if(DEFINED NRFORGE_@upper_protocol@_EXPECTED_FINGERPRINT AND
   NOT NRFORGE_@upper_protocol@_EXPECTED_FINGERPRINT STREQUAL @package@_FINGERPRINT)
  message(FATAL_ERROR "@package@ requested SDK fingerprint does not match installed package")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/@package@Targets.cmake")
check_required_components(@package@)
