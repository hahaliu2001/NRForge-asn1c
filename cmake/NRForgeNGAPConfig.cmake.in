@PACKAGE_INIT@
set(NRForgeNGAP_VERSION "@NRFORGE_SDK_VERSION@")
set(NRForgeNGAP_FINGERPRINT "@NRFORGE_SDK_FINGERPRINT@")
set(NRForgeNGAP_SCHEMA_SHA256 "@NRFORGE_SCHEMA_SHA256@")
set(NRForgeNGAP_RUNTIME_SHA256 "@NRFORGE_RUNTIME_SHA256@")
if(DEFINED NRFORGE_NGAP_EXPECTED_FINGERPRINT AND
   NOT NRFORGE_NGAP_EXPECTED_FINGERPRINT STREQUAL NRForgeNGAP_FINGERPRINT)
  message(FATAL_ERROR "NRForgeNGAP requested SDK fingerprint does not match installed package")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/NRForgeNGAPTargets.cmake")
check_required_components(NRForgeNGAP)
